# Defaults run a local pipeline demo. These are NOT neural semantic models.
EMBEDDING_BACKEND=hash
RERANKER_BACKEND=lexical
GENERATION_BACKEND=extractive
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_REVISION=main
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_REVISION=main
CHUNKING_STRATEGY=recursive
CHUNK_SIZE=120
CHUNK_OVERLAP=20
# Optional server default. Alternatively enter provider/model/key in website settings.
# For Gemini: GENERATION_BACKEND=api
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=<an available Gemini chat model ID from your account>
# Keep actual keys in .env or environment variables, never in this example.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=60
# Local run may omit QDRANT_URL to use immutable NumPy vector snapshots.
# Compose sets QDRANT_URL to the internal qdrant service.
DATA_DIR=./data/runtime
LIBREOFFICE_PATH=soffice
